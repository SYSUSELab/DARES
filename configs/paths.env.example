# Copy this file to configs/paths.env and edit the paths for your machine.
BASE_MODEL=/path/to/Qwen3-4B-Instruct
CODEREVAL_TASKS=/path/to/coderag_three_sources_raw_contexts.jsonl
REPOEVAL_TASKS=/path/to/RepoEval_tasks.jsonl
REPOEVAL_PATH_METADATA=/path/to/repoeval_path_metadata.jsonl
CODEREVAL_RLCODER=/path/to/codereval_rlcoder_top10.jsonl
CODEREVAL_RERANKER=/path/to/codereval_reranker_top10.jsonl
REPOEVAL_RLCODER=/path/to/repoeval_rlcoder_top10.jsonl
REPOEVAL_RERANKER=/path/to/repoeval_reranker_top10.jsonl

# Optional downstream generation/evaluation runners. Each runner receives
# CONTEXTS_FILE (CoderEval) or SELECTION_FILE (RepoEval) and OUTPUT_ROOT.
CODEREVAL_GENERATOR_RUNNER=/path/to/run_codereval_generators.sh
REPOEVAL_GENERATOR_RUNNER=/path/to/run_repoeval_generators.sh
